{
  "name": "breeze-chms",
  "version": "1.2.0",
  "description": "Provides convenient access to the Breeze REST API - https://app.breezechms.com/api.",
  "keywords": [
    "breeze",
    "chms"
  ],
  "scripts": {
    "test": "jest --config jestconfig.json",
    "test-watch": "jest --config jestconfig.json --watch",
    "watch": "tsc --watch",
    "clean": "rm -rf build",
    "build:esm": "tsc",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run test"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/esm/index.d.ts",
      "import": "./build/esm/index.js",
      "require": "./build/cjs/index.js",
      "default": "./build/esm/index.js"
    }
  },
  "main": "./build/cjs/index.js",
  "module": "./build/esm/index.js",
  "types": "./build/esm/index.d.ts",
  "files": [
    "build/**/*"
  ],
  "homepage": "https://github.com/contentguru-ai/breeze-chms",
  "bugs": {
    "url": "https://github.com/contentguru-ai/breeze-chms/issues",
    "email": "support@notebird.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contentguru-ai/breeze-chms.git"
  },
  "author": "Chris Doe <cdoe@notebird.app> (notebird.app)",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=20"
  },
  "engineStrict": true,
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.5",
    "@types/jest": "^30.0.0",
    "dotenv": "^17.3.1",
    "jest": "^30.3.0",
    "jest-to-match-shape-of": "^1.3.2",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  }
}
